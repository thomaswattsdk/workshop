  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "docker",
      "docker *"
    ],
    "filesystem": {
      "denyWrite": [
        "/mnt"
      ]
    },
    "network": {
      "strictAllowlist": true,
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "registry.npmjs.org"
      ],
      "tlsTerminate": {}
    },
    "credentials": {
      "files": [
        {
          "path": "~/.config/gh/hosts.yml",
          "mode": "mask",
          "extract": "oauth_token:\\s*(\\S+)",
          "injectHosts": [
            "api.github.com",
            "github.com"
          ]
        }
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/etc/claude-code/workshop-guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
